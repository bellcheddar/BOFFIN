# BOFFIN is a native Xcode project: BOFFIN.xcodeproj IS committed and is the
# source of truth for project configuration. Only per-user state is ignored.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
DerivedData/
build/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store

# Python (Tools/coreml, Tools/data)
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Large model artefacts: regenerated by Tools/coreml, never committed
*.mlpackage/
*.mlmodelc/
*.pt
*.pth
*.safetensors

# The vendored Mol* build is committed on purpose. It is five megabytes and it
# is what makes the viewer work in aeroplane mode; see Packages/BoffinViewer/VENDOR.md.

# Downloaded assets and caches
Tools/coreml/.cache/
Tools/data/.cache/

# Session transcripts and scratch
*.session.md
scratch/

# Converted model artefacts. Regenerated by Tools/coreml/convert_backbone.py.
# The tokeniser JSON IS committed: it is the contract between the Python
# converter and the Swift tokeniser, it is two kilobytes, and a repository that
# cannot tokenise without first running a 4 GB toolchain is not much use.
Models/*.reference.npz

# Class centroids are an intermediate: the values that ship are embedded in
# Models/heads/family_labels.json, which IS committed.
Models/heads/*.npy

# Head training datasets. Hundreds of megabytes, reproducible from
# Tools/data/fetch_head_datasets.py; provenance in Datasets/MANIFEST.md.
Datasets/*.npz
Datasets/*.json

# PDB bulk downloads and the built index. Around 500 MB of inputs and 105 MB of
# packed assets, all reproducible from Tools/data/build_pdb_index.py; provenance
# and the exact commands are in Datasets/pdb/MANIFEST.md.
Datasets/pdb/*
Datasets/codon/*.fna
Datasets/pdblabels/
!Datasets/pdb/MANIFEST.md
Assets/
