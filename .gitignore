*.xcworkspace
!*.xcworkspace/contents.xcworkspacedata
Derived/
.build/
DerivedData/
*.xcuserstate
xcuserdata/

# Tuist
.tuist-version
Tuist/.build/
Tuist/Dependencies/

# Swift Package Manager
.swiftpm/
Package.resolved

# macOS
.DS_Store

# Python (Tools/coreml, Tools/data)
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

