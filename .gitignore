# BOFFIN is a native Xcode project: BOFFIN.xcodeproj IS committed and is the
# source of truth for project configuration. Only per-user state is ignored.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
DerivedData/
build/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store

# Python (Tools/coreml, Tools/data)
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Large model artefacts: regenerated by Tools/coreml, never committed
*.mlpackage/
*.mlmodelc/
*.pt
*.pth
*.safetensors

# Downloaded assets and caches
Tools/coreml/.cache/
Tools/data/.cache/

# Session transcripts and scratch
*.session.md
scratch/
